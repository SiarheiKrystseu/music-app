<configuration>

    <!-- Access Spring Boot properties -->
    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}", "service":"${appName}", "level":"%-5level", "thread":"%thread", "logger":"%logger{35}", "traceId":"%X{traceId}", "message":"%msg"}%n</pattern>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>